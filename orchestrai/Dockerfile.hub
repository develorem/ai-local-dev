FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY server /app/server
COPY ui /app/ui
COPY scripts /app/scripts
# Shared MCP tool definitions, hosted in-process by server/mcp_integration.py.
COPY mcp/orchestrai_mcp.py /app/orchestrai_mcp.py

ENV DATA_DIR=/data \
    OLLAMA_URL=http://ollama:11434 \
    HUB_HOST=0.0.0.0 \
    HUB_PORT=6724

EXPOSE 6724

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:6724/api/health || exit 1

CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "6724"]
