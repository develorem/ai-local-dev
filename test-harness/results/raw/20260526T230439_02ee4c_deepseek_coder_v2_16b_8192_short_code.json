    "text": " ```python\nfrom datetime import datetime, timezone\nimport re\n\ndef parse_iso8601(s: str) -> datetime:\n    # Define regex patterns for different ISO-8601 formats\n    iso8601_regex = (\n        r'^(?P<year>[+-]?\\d{4})-(?P<month>\\d{2})-(?P<day>\\d{2})'  # YYYY-MM-DD\n        r'(?:[T ]?(?P<hour>\\d{2}):(?P<minute>\\d{2})(?::(?P<second>\\d{2})(\\.(?P<microsecond>\\d+))?)?'  # T HH:MM[:SS[.ffffff]]\n        r'|(?:Z|(?P<offset_hour>\\d{2})(?::?(?P<offset_minute>\\d{2}))?)$'  # Z or \u00b1HH:MM\n    )\n    \n    match = re.match(iso8601_regex, s)\n    if not match:\n        raise ValueError(\"Unparseable input\")\n    \n    # Extract matched groups\n    groups = match.groupdict()\n    \n    # Handle the case where there's no time part (just date)\n    if not any(groups.values()):\n        return datetime(int(groups['year']), int(groups['month']), int(groups['day']), tzinfo=timezone.utc)\n    \n    # Parse time parts\n    hour = int(groups['hour']) if groups['hour'] is not None else 0\n    minute = int(groups['minute']) if groups['minute'] is not None else 0\n    second = int(groups['second']) if groups['second'] is not None else 0\n    microsecond = (int(groups['microsecond']) if groups['microsecond'] is not None else 0) * 10**(len(groups['microsecond']) - 6)\n    \n    # Create datetime object with parsed time parts\n    dt = datetime(int(groups['year']), int(groups['month']), int(groups['day']), hour, minute, second, microsecond, tzinfo=timezone.utc)\n    \n    # Handle offsets if present\n    if 'offset_hour' in groups or s[-1] == 'Z':\n        offset_hour = int(groups['offset_hour']) if groups['offset_hour'] is not None else 0\n        offset_minute = int(groups['offset_minute']) if groups['offset_minute'] is not None else 0\n        offset = timezone(timedelta(hours=offset_hour, minutes=offset_minute))\n        dt = dt.replace(tzinfo=offset)\n    \n    return dt\n\n# Examples\ntry:\n    print(parse_iso8601(\"2023-10-05T14:23:17Z\"))  # Trailing Z for UTC\n    print(parse_iso8601(\"2023-10-05T14:23:17+05:30\"))  # Explicit offset\n    print(parse_iso8601(\"2023-10-05T14:23:17-07:00\"))  # Explicit negative offset\n    print(parse_iso8601(\"2023-10-05T14:23:17\"))  # Naive timestamp, interpreted as UTC\n    print(parse_iso8601(\"invalid input\"))  # Invalid input should raise ValueError\nexcept ValueError as e:\n    print(e)\n```",
