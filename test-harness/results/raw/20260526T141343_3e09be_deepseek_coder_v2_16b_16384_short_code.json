    "text": " ```python\nfrom datetime import datetime, timezone\nimport re\n\ndef parse_iso8601(s: str) -> datetime:\n    # Define regex patterns for different ISO-8601 formats\n    iso8601_regex = (\n        r'^(?P<year>[+-]?\\d{4})-(?P<month>\\d{2})-(?P<day>\\d{2})'  # YYYY-MM-DD\n        r'(?:[T ]?(?P<hour>\\d{2}):(?P<minute>\\d{2})(?::(?P<second>\\d{2})(?:\\.(?P<microsecond>\\d+))?)?'  # H:M:S.us\n        r'|(?:Z|(?P<offset_hour>\\d{2})(?::?(?P<offset_minute>\\d{2}))?)$'  # Z or +HH:MM/-HH:MM\n    )\n    \n    match = re.match(iso8601_regex, s)\n    if not match:\n        raise ValueError(\"Unparseable input\")\n    \n    # Extract matched groups\n    groups = match.groupdict()\n    \n    # Handle the case where there's no time part (just date)\n    if not any(groups[key] for key in ['hour', 'minute', 'second', 'microsecond']):\n        return datetime(\n            int(groups['year']), \n            int(groups['month']), \n            int(groups['day']), \n            tzinfo=timezone.utc\n        )\n    \n    # Handle the case where there's a time part but no offset (naive time in UTC)\n    if not any(groups[key] for key in ['offset_hour', 'offset_minute']):\n        naive_time = datetime(\n            int(groups['year']), \n            int(groups['month']), \n            int(groups['day']), \n            int(groups['hour']), \n            int(groups['minute']), \n            int(groups['second']), \n            int(groups['microsecond']) if groups['microsecond'] else 0,\n            tzinfo=timezone.utc\n        )\n        return naive_time.replace(tzinfo=None)  # Convert to naive datetime in UTC\n    \n    # Handle the case with explicit offset or trailing 'Z' for UTC\n    year = int(groups['year']) if groups['year'] else None\n    month = int(groups['month'])\n    day = int(groups['day'])\n    hour = int(groups['hour']) if groups['hour'] else 0\n    minute = int(groups['minute']) if groups['minute'] else 0\n    second = int(groups['second']) if groups['second'] else 0\n    microsecond = int(groups['microsecond']) if groups['microsecond'] else 0\n    \n    offset_hour = int(groups['offset_hour']) if groups['offset_hour'] else 0\n    offset_minute = int(groups['offset_minute']) if groups['offset_minute'] else 0\n    \n    if s.endswith('Z'):\n        tzinfo = timezone.utc\n    else:\n        sign = -1 if s[0] == '-' else 1\n        tzinfo = timezone(timedelta(hours=sign * offset_hour, minutes=sign * offset_minute))\n    \n    return datetime(\n        year, month, day, hour, minute, second, microsecond, tzinfo=tzinfo\n    )\n\n# Examples\ntry:\n    print(parse_iso8601(\"2023-10-05T14:30:00Z\"))  # ISO-8601 with trailing 'Z'\n    print(parse_iso8601(\"2023-10-05T14:30:00+05:00\"))  # ISO-8601 with explicit offset\n    print(parse_iso8601(\"2023-10-05T14:30:00\"))  # Naive timestamp interpreted as UTC\n    print(parse_iso8601(\"2023-10-05\"))  # Just a date, treated as UTC time\nexcept ValueError as e:\n    print(e)\n\ntry:\n    print(parse_iso8601(\"invalid input\"))  # Invalid input that raises ValueError\nexcept ValueError as e:\n    print(e)\n```",
