    "text": " ```python\nfrom datetime import datetime, timezone\nimport re\n\ndef parse_iso8601(s: str) -> datetime:\n    # Define regex patterns for different ISO-8601 formats\n    iso8601_regex = (\n        r'^(?P<year>[+-]?\\d{4})-(?P<month>\\d{2})-(?P<day>\\d{2})'  # YYYY-MM-DD\n        r'(?:[T ]?(?P<hour>\\d{2}):(?P<minute>\\d{2})(?::(?P<second>\\d{2})(?:\\.(?P<microsecond>\\d+))?)?'  # H:M:S.us\n        r'|(?:Z|(?P<offset_hour>\\d{2})(?::?(?P<offset_minute>\\d{2}))?)$'  # Z or +HH:MM/-HH:MM\n    )\n    \n    match = re.match(iso8601_regex, s)\n    if not match:\n        raise ValueError(\"Unparseable input\")\n    \n    # Extract matched groups\n    groups = match.groupdict()\n    \n    # Handle the case where there's no time part (just date)\n    if None in ['hour', 'minute', 'second', 'microsecond']:\n        year, month, day = int(groups['year']), int(groups['month']), int(groups['day'])\n        dt = datetime(year, month, day, tzinfo=timezone.utc)\n    else:\n        # Parse time parts\n        hour = int(groups['hour']) if groups['hour'] is not None else 0\n        minute = int(groups['minute']) if groups['minute'] is not None else 0\n        second = int(groups['second']) if groups['second'] is not None else 0\n        microsecond = int(groups['microsecond']) if groups['microsecond'] is not None else 0\n        \n        # Handle offset or timezone information\n        if 'offset_hour' in groups:\n            offset_hour = int(groups['offset_hour'])\n            offset_minute = int(groups['offset_minute']) if groups['offset_minute'] is not None else 0\n            tzinfo = timezone(timedelta(hours=offset_hour, minutes=offset_minute))\n        elif 'Z' in s:\n            tzinfo = timezone.utc\n        else:\n            raise ValueError(\"Unparseable input\")\n        \n        # Construct datetime with parsed components\n        dt = datetime(int(groups['year']), int(groups['month']), int(groups['day']), \n                      hour, minute, second, microsecond, tzinfo=tzinfo)\n    \n    return dt\n\n# Examples\ntry:\n    print(parse_iso8601(\"2023-10-05T12:34:56Z\"))  # Trailing Z for UTC\n    print(parse_iso8601(\"2023-10-05T12:34:56+00:00\"))  # Explicit +00:00 offset\n    print(parse_iso8601(\"2023-10-05T12:34:56-07:00\"))  # Explicit -07:00 offset\n    print(parse_iso8601(\"2023-10-05\"))  # Naive date, interpreted as UTC\n    print(parse_iso8601(\"invalid input\"))  # Invalid input should raise ValueError\nexcept ValueError as e:\n    print(e)\n```",
