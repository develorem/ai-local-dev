    "text": "```python\nfrom datetime import datetime, timedelta, timezone\n\ndef parse_iso8601(s: str) -> datetime:\n    try:\n        if s.endswith('Z'):\n            return datetime.strptime(s[:-1], '%Y-%m-%dT%H:%M:%S.%fZ')\n        elif '+' in s or '-' in s:\n            parts = s.split('T')\n            date_part, time_part = parts[0], parts[1].split('+')[0]\n            offset_part = parts[1].split('+')[1] if '+' in s else parts[1].split('-')[1]\n            dt = datetime.strptime(date_part + 'T' + time_part, '%Y-%m-%dT%H:%M:%S.%f')\n            hours, minutes = map(int, offset_part.split(':'))\n            if '-' in s:\n                hours *= -1\n                minutes *= -1\n            return dt.replace(tzinfo=timezone(timedelta(hours=hours, minutes=minutes)))\n        else:\n            return datetime.strptime(s, '%Y-%m-%dT%H:%M:%S.%f')\n    except ValueError:\n        raise ValueError(f\"Invalid ISO-8601 timestamp: {s}\")\n\n# Examples\nprint(parse_iso8601(\"2023-04-12T12:00:00Z\"))  # UTC\nprint(parse_iso8601(\"2023-04-12T12:00:00+02:00\"))  # +2 hours offset\nprint(parse_iso8601(\"2023-04-12T12:00:00-04:00\"))  # -4 hours offset\nprint(parse_iso8601(\"2023-04-12T12:00:00\"))  # Naive timestamp (interpreted as UTC)\nprint(parse_iso8601(\"invalid_timestamp\"))  # Raises ValueError\n```",
