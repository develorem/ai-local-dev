# Caches / environments — never commit
__pycache__/
*.pyc
.venv/

# Daemon logs (not benchmark data — pure Ollama chatter, multi-MB)
results/ollama_serve_*.log
results/ollama_serve_*.log.err

# Empty / stale analysis output (regenerated by scripts/analyze.py)
results/overnight_analysis.txt

# Everything else under results/ IS committed:
#   csv/runs.csv, csv/quality.csv      -> source-of-truth tables
#   raw/*.json                          -> per-cell rich data (responses, monitor samples)
#   overnight_*.log                     -> bench run progress + errors
