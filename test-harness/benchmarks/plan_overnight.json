{
  "name": "overnight",
  "_description": "Full overnight sweep: every viable model x 4 contexts x (throughput + quality). The harness skips models whose tags don't exist on this machine.",

  "throughput_prompts": [
    {"name": "short-code", "expected_contains": ["def "]},
    {"name": "medium-explain"},
    {"name": "long-context"}
  ],
  "quality_problems": [
    "two_sum", "valid_parens", "count_substring", "roman_to_int",
    "flatten_list", "merge_intervals", "parse_csv_row", "fix_bug_dedup",
    "long_module_bug"
  ],
  "quality_tool_calls": [
    "json_basic", "json_grep", "args_correctness", "multi_step_plan", "refuse_destructive"
  ],
  "skip_quality_below_context": {
    "long_module_bug": 8192
  },
  "skip_throughput_below_context": {
    "long-context": 8192
  },

  "contexts": [4096, 8192, 16384, 32768],

